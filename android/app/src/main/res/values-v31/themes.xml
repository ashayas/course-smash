<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw the splash themselves: the launcher mark on ink. -->
    <style name="Theme.CourseSmash" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:windowSplashScreenBackground">@color/ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">@color/ink</item>
    </style>
</resources>
