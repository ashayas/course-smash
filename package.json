{
  "name": "coursesmash",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply coursesmash-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply coursesmash-db --remote",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "build:server": "esbuild src/server/node.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start:server": "node dist/server.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check:isolation": "node scripts/check-isolation.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "katex": "^0.19.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.2"
  }
}
