# Release signing for the Course Smash Android app.
#
# Copy this file to keystore.properties (ignored by git) and fill it in. Neither the keystore
# nor these passwords ever go in the repository. See README.md, "Signing".
#
# storeFile is relative to android/. Create the upload keystore once with:
#   keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storeFile=upload-keystore.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=upload
keyPassword=REPLACE_WITH_KEY_PASSWORD
