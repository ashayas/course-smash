# App Store Connect and Developer Portal settings for fastlane.
# Nothing secret goes here. The three values below are placeholders read from the environment:
#   FASTLANE_APPLE_ID   the Apple ID that uploads builds (an email address)
#   DEVELOPMENT_TEAM    your 10-character Developer Team ID
#   FASTLANE_ITC_TEAM_ID  only if the Apple ID belongs to more than one App Store Connect team
app_identifier "app.coursesmash.ios"
apple_id ENV["FASTLANE_APPLE_ID"] if ENV["FASTLANE_APPLE_ID"]
team_id ENV["DEVELOPMENT_TEAM"] if ENV["DEVELOPMENT_TEAM"]
itc_team_id ENV["FASTLANE_ITC_TEAM_ID"] if ENV["FASTLANE_ITC_TEAM_ID"]
